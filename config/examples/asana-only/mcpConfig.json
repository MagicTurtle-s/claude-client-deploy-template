{
  "description": "MCP Configuration - Asana Only",
  "mcps": {
    "hubspot": {
      "enabled": false,
      "description": "HubSpot CRM - 116 tools for companies, contacts, deals, leads",
      "transport": "http",
      "requiresAuth": true,
      "envVars": ["HUBSPOT_ACCESS_TOKEN"]
    },
    "sharepoint": {
      "enabled": false,
      "description": "SharePoint document management",
      "transport": "http",
      "requiresAuth": true,
      "envVars": ["SHAREPOINT_CLIENT_ID", "SHAREPOINT_CLIENT_SECRET"]
    },
    "asana": {
      "enabled": true,
      "description": "Asana project management",
      "transport": "sse",
      "requiresAuth": true,
      "envVars": ["ASANA_ACCESS_TOKEN"]
    }
  }
}
